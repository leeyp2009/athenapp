  cout << "main initial: rp, phi, vr, omega: "<< PS[0].getRad()<<", " 
       << PS[0].getPhi() <<", " << PS[0].getVr() << ", " 
       << PS[0].getVp() <<endl;

  for (real t=0.0; t<tlim; ) {
     update_planet(dt, NT);
     t += dt;
