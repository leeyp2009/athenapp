for (int n = 0; n<nPlanet; n++){
  rp0[n] *= (1.0-ecc0[n]);
  vp0[n] = sqrt((mass0[n]+1.0)/rp0[n])*sqrt(1.0+ecc0[n]) - OMEGA*rp0[n];
  vr0[n] = 0.0;
}

if (BINARY) {
   real r_COM = (mass0[0]*rp0[0] + mass0[1]*rp0[1])/(mass0[0]+mass0[1]); // if phi0=phi1
   real vk = sqrt((mass0[0]+mass0[1]+1.0)/r_COM); //vk at center of mass
   real vbin0 = sqrt(mass0[1]*mass0[1]/rbin/(mass0[0]+mass0[1]));
   real vbin1 = sqrt(mass0[0]*mass0[0]/rbin/(mass0[0]+mass0[1]));

   vp0[0] = vk + binary_orb*vbin0 - OMEGA*rp0[0];
   vp0[1] = vk - binary_orb*vbin1 - OMEGA*rp0[1];
   vr0[0] = 0.0;
   vr0[1] = 0.0;
}


for (int n = 0; n<nPlanet; n++){
  PS.push_back(Planet(rp0[n],phi0[n],mass0[n],ecc0[n]));
  PS[n].setIndex(n);
  PS[n].setVr(vr0[n]);
  PS[n].setVp(vp0[n]);
}
